library (dd2_functional) {
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  cell (dd2_g5__mux2_1) {
    area : 0.0;
    pin (A0) {
      direction : input;
    }
    pin (A1) {
      direction : input;
    }
    pin (S) {
      direction : input;
    }
    pin (X) {
      direction : output;
      function : "(A0 & !S) | (A1 & S)";
    }
  }
}
