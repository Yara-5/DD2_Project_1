library (dd2_functional) {
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  cell (dd2_g5__o21ai_1) {
    area : 0.0;
    pin (A1) {
      direction : input;
    }
    pin (A2) {
      direction : input;
    }
    pin (B1) {
      direction : input;
    }
    pin (Y) {
      direction : output;
      function : "!((A1 | A2) & B1)";
    }
  }
}
