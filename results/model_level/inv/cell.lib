library (dd2_functional) {
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.8;
  cell (dd2_g5__inv_1) {
    area : 0.0;
    pin (A) {
      direction : input;
    }
    pin (Y) {
      direction : output;
      function : "!A";
    }
  }
}
